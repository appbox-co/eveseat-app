# Release metadata for this branch, read by release/build-on-builder.sh and
# the release gate. Plain KEY=value lines only.
#
# 5.0.1-6 is an overlay release: the released 5.0.1-5 image with the files
# listed as gate_overlay_file replaced (see Dockerfile.release). The gate is
# release/verify-sde-overlay.sh.
cylo_build_kind=overlay
cylo_build_repo_slug=eveseat-app
cylo_build_image=eveseat
cylo_build_tag=5.0.1-6
cylo_build_release_ref=repo.cylo.net/eveseat:5.0.1-6
cylo_build_dockerfile=Dockerfile.release
cylo_build_git_remote=origin
cylo_build_git_branch=sde-import-fix
cylo_build_gate=release/verify-sde-overlay.sh
# The released image this one is built on (5.0.1-5).
gate_base_ref=repo.cylo.net/eveseat@sha256:5fdb93052c1d27f8e30722fbdf337632340ce0f0902771fb239d93ba5f6783f6
# PHP must still be the release with the 19 November 2026 security fixes.
gate_php_release_version=8.2.36
# <committed file>:<path in the image>, one per COPY in Dockerfile.release.
gate_overlay_file=scripts/Entrypoint.sh:/entrypoint.sh
gate_overlay_file=scripts/AppboxSdeUpdater.php:/opt/seat-preinstall/seat/vendor/eveseat/eveapi/src/Commands/Eve/Update/AppboxSdeUpdater.php
