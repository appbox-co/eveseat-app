# Release metadata for this branch, read by release/build-on-builder.sh and
# the release gate. Plain KEY=value lines only.
#
# 5.0.1-5 is a PHP release: the released 5.0.1-4 image with PHP's own files
# replaced by PHP 8.2.36 (see Dockerfile.release). The gate is
# release/verify-image.sh, as for 5.0.1-3.
cylo_build_kind=official-php
cylo_build_repo_slug=eveseat-app
cylo_build_image=eveseat
cylo_build_tag=5.0.1-5
cylo_build_release_ref=repo.cylo.net/eveseat:5.0.1-5
cylo_build_dockerfile=Dockerfile.release
cylo_build_git_remote=origin
cylo_build_git_branch=php-8.2.36
cylo_build_gate=release/verify-image.sh
# The released image this one is built on (5.0.1-4).
gate_base_ref=repo.cylo.net/eveseat@sha256:7474bd7a45eb159fec1727b2f77953e3a71920c07a662b584ca4a8307c768a86
# The PHP release with the security fixes of 19 November 2026.
gate_php_release_version=8.2.36
gate_php_image_pattern=repo.cylo.net/php-artifacts:docker-library-php-8.2.36-fpm-bookworm
gate_php_extension_dir=/usr/local/lib/php/extensions/no-debug-non-zts-20220829
# Renders the nginx configuration as the container does at start, before nginx -t.
gate_web_prepare=/release/web-prepare.sh
