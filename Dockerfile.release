# SeAT 5.0.1-6: the released 5.0.1-5 image (repo.cylo.net/eveseat:5.0.1-5,
# PHP 8.2.36) with two files replaced and nothing else changed.
#
# CCP's EVE static data build 3720952 (19 November 2026) has a type name of
# 161 characters, longer than the 150 SeAT's InvTypesSeeder allows, so strict
# MariaDB rejects the import. The import ran from /entrypoint.sh on every
# container (re)creation and its failure was fatal, so an updated SeAT
# restarted forever; the monthly scheduled run would also have left invTypes
# partial on running installs.
#
# - /entrypoint.sh (scripts/Entrypoint.sh) patches the persisted SeAT tree on
#   every start, only where the files are exactly the known versions: it
#   installs the fixed updater over the 5.0.1-2 Appbox updater and widens
#   invTypes.typeName to 255 characters. If an import still fails or times
#   out, it restores the previous static-data tables and starts SeAT on them
#   instead of exiting; only an install without any static data stays fatal.
# - The release tree's AppboxSdeUpdater.php (scripts/AppboxSdeUpdater.php)
#   copies the static-data tables before an import, puts them back when the
#   import fails, and logs the database driver's error (no SQL or values)
#   instead of only the exception class.
#
# SEAT_IMAGE_VERSION and SEAT_IMAGE_REVISION are inherited unchanged on
# purpose: re-applying a release replaces vendor/ in the persisted tree, which
# would remove customer-installed plugins.

FROM repo.cylo.net/eveseat@sha256:5fdb93052c1d27f8e30722fbdf337632340ce0f0902771fb239d93ba5f6783f6

COPY --chmod=755 scripts/Entrypoint.sh /entrypoint.sh
COPY --chmod=644 scripts/AppboxSdeUpdater.php /opt/seat-preinstall/seat/vendor/eveseat/eveapi/src/Commands/Eve/Update/AppboxSdeUpdater.php
